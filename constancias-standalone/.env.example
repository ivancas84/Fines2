# API key compartida con fines-standalone (POST /api/toma-posesion).
# CONSTANCIAS_API_KEY=cambiar-por-un-secreto-largo
# DEFAULT_ESTABLECIMIENTO_ID=1

# SMTP opcional para enviar tomas de posesión por email.
# Los valores con espacios o caracteres especiales van entre comillas dobles.
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=docentes@example.com
# SMTP_PASSWORD="tu-clave"
# SMTP_FROM_ADDRESS=docentes@example.com
# SMTP_FROM_NAME="Docentes CENS 462"
# SMTP_BCC=coordinacion@example.com
# SMTP_MAX_ATTEMPTS=3

# Textos del email de toma (opcionales).
# TOMA_EMAIL_FECHA_LIMITE_NOTAS=21/12/2026
# TOMA_EMAIL_RECUPERACION="18/08/2026 a 18/12/2026"
# TOMA_EMAIL_WHATSAPP=2216713326
# TOMA_EMAIL_INSTRUCCIONES_URL=https://planfines2.com.ar/wp/finalizacion-de-semestre/
# TOMA_EMAIL_COBRO_URL=
# TOMA_EMAIL_WEB_URL=https://planfines2.com.ar
# TOMA_EMAIL_FIRMA="Equipo de Coordinadores del Plan Fines 2 CENS 462"
