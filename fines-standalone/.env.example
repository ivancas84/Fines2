APP_NAME="Fines"
APP_ENV=local
APP_DEBUG=true
APP_BASE_PATH=/Fines2/fines-standalone/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=planfi10_20204
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8

SESSION_NAME=fines_app_session

# Sistema externo e independiente de constancias.
CONSTANCIAS_PUBLIC_URL=http://localhost/Fines2/constancias-standalone/public
# Debe coincidir con CONSTANCIAS_API_KEY de constancias-standalone (.env).
# CONSTANCIAS_API_KEY=cambiar-por-un-secreto-largo

APP_PUBLIC_URL=http://localhost/Fines2/fines-standalone/public
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/Fines2/fines-standalone/public/login/google/callback

# Identificador interno del período vigente en programafines.ar.
PROGRAMAFINES_PERIOD=6

# Opcional: calendario vigente.
# - Default al generar comisión siguiente (si no se calcula el período siguiente).
# - Default al procesar docentes PF (tomas por PFID + calendario).
# - Listado público de toma de posesión (/toma-posesion).
#   Si no se define, se usa el último calendario (año/semestre).
# CALENDARIO_ID_ACTUAL=

# Formulario externo de toma de posesión (enlace "Tomar" del listado público).
# TOMA_POSESION_FORM_URL=https://planfines2.com.ar/wp/toma-de-posesion/
